# Backend API URL
BACKEND_URL=http://localhost:8020

# Frontend port (default: 3001 to avoid conflict with Kosmos on :3000)
PORT=3001

# Optional: GPU monitoring thresholds (for UI display only)
# GPU_YELLOW_TEMP=51
# GPU_RED_ZONE=88
# GPU_OPERATIONAL_CEILING=80
