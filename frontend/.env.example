# Tektos frontend runtime config
#
# The frontend talks to two Tektos endpoints:
#   - Gateway WebSocket (JSON-RPC 2.0) via tektos.gateway_proxy on port 8765
#   - Backend HTTP REST via tektos.main FastAPI on port 8020
#
# Copy to .env.local and edit if your hosts/ports differ.

NEXT_PUBLIC_TEKTOS_HOST=localhost
NEXT_PUBLIC_TEKTOS_HTTP_PORT=8020
NEXT_PUBLIC_TEKTOS_WS_PORT=8765
NEXT_PUBLIC_TEKTOS_WS_PROTOCOL=ws
