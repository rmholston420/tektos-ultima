[Unit]
Description=Tektos-Ultima full stack (backend + hindsight)
Documentation=https://github.com/rmholston420/tektos-ultima
# Bring up every Tektos service. Uses Wants= (not Requires=) so a single
# failing service does not stop the whole target — matches PartOf= on each
# unit, which means stopping the target stops all four, but any one of
# them failing does not cascade.
#
# Stage 9.5 (ADR-113, kosmos-lms): tektos-frontend (:5556) and
# tektos-gateway (:8765) are retired — the Tektos API is served
# same-origin through the kosmos kernel gateway
# (/api/tektos-ultima/gateway/*, ADR-109) and the native Kosmos
# dashboard (/tektos-ultima) replaces the standalone frontend.
Wants=tektos-backend.service tektos-llm-hindsight.service tektos-hindsight.service
After=tektos-backend.service tektos-llm-hindsight.service tektos-hindsight.service

[Install]
WantedBy=default.target
