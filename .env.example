# ──────────────────────────────────────────────────────────────────────────────
# Tektos Development Environment Example
# Copy to .env and fill in actual values
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
TEKTOS_PORT=8020
DEBUGGER_PORT=5555
TEKTOS_URL=http://localhost:8020
TEKTOS_CPU_LIMIT=4.0
TEKTOS_CPU_RESERVE=0.5
TEKTOS_MEMORY_LIMIT=8G
TEKTOS_MEMORY_RESERVE=1G

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=tektos
POSTGRES_USER=tektos
POSTGRES_PASSWORD=tektos_secure_password
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Telegram Gateway ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Email Gateway ────────────────────────────────────────────────────────────
EMAIL_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Default model config for routing
ROUTING_DEFAULT_MODEL_NAME=qwen3-6-35b-a3b
ROUTING_DEFAULT_API_BASE=http://localhost:8080
