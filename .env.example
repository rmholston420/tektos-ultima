# ──────────────────────────────────────────────────────────────────────────────
# Tektos Development Environment Example
# Copy to .env and fill in actual values
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
TEKTOS_PORT=8020
DEBUGGER_PORT=5555
TEKTOS_URL=http://localhost:8020
TEKTOS_CPU_LIMIT=4.0
TEKTOS_CPU_RESERVE=0.5
TEKTOS_MEMORY_LIMIT=8G
TEKTOS_MEMORY_RESERVE=1G

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=tektos
POSTGRES_USER=tektos
POSTGRES_PASSWORD=tektos_secure_password
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Telegram Gateway ─────────────────────────────────────────────────────────
TEKTOS_TELEGRAM_BOT_TOKEN=
TEKTOS_TELEGRAM_ADMIN_CHAT_ID=

# ── Email Gateway ────────────────────────────────────────────────────────────
EMAIL_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ── LLM: pick ONE topology below (Hermes proxy is the recommended default) ──
#
# Two supported deployment layouts. See docs/HERMES_TOPOLOGY.md for the full
# runbook and the reasoning behind these defaults.
#
# TOPOLOGY A — Hermes proxy (recommended)
#   Tektos talks to a single endpoint (Hermes on port 8093). Hermes owns the
#   GPU→CPU failover to llama-server on 8090 and 8092. Tektos-side failover
#   is disabled because Hermes handles it.
#
TEKTOS_LLM_BASE_URL=http://127.0.0.1:8093/v1
TEKTOS_LLM_MODEL=qwen3.8-27b-code
TEKTOS_LLM_FAILOVER_ENABLED=false
#
# TOPOLOGY B — Direct llama-server (fallback if Hermes is not running)
#   Tektos talks to primary llama-server on 8090 and manages failover to the
#   secondary on 8092 itself. Uncomment these lines AND comment out the
#   TOPOLOGY A block above to use this layout.
#
# TEKTOS_LLM_BASE_URL=http://127.0.0.1:8090/v1
# TEKTOS_LLM_MODEL=qwen3.8-27b-code
# TEKTOS_LLM_FALLBACK_URL=http://127.0.0.1:8092/v1
# TEKTOS_LLM_FALLBACK_MODEL=granite4.1-8b-instruct
# TEKTOS_LLM_FAILOVER_ENABLED=true
# TEKTOS_LLM_FAILOVER_COOLDOWN_SECONDS=30

# ── Prompt timeout (applies to both topologies) ─────────────────────────────
# Maximum wall-clock seconds any single prompt is allowed to run before
# _stream_llm aborts and fires session.fail with outcome="timeout".
# Introduced in PR #9. Default 120s.
TEKTOS_PROMPT_TIMEOUT_SECONDS=120

# ── Embedder (Qwen3-Embedding-0.6B on CPU, port 8091) ───────────────────────
TEKTOS_EMBEDDER_BASE_URL=http://127.0.0.1:8091/v1
TEKTOS_EMBEDDER_MODEL=qwen3-embedding-0.6b

# ── Vision (Qwen3-VL-4B on CPU, port 8094) ──────────────────────────────────
TEKTOS_VISION_URL=http://127.0.0.1:8094/v1
TEKTOS_VISION_MODEL=qwen3-vl-4b

# ── Web Search ──────────────────────────────────────────────────────────────
TEKTOS_SEARXNG_URL=http://localhost:8888/search

# ── Legacy routing (kept for compatibility with older ModelRouter callers) ──
ROUTING_DEFAULT_MODEL_NAME=qwen3.8-27b-code
ROUTING_DEFAULT_API_BASE=http://127.0.0.1:8090/v1
